# Clés d'API de CV Builder Pro. Copie ce fichier en .env, ou saisis ta clé dans Réglages.
# .env reste sur ta machine : il n'est jamais versionné ni renvoyé par l'appli.

# Gemini de Yahya : le code d'accès qu'il t'a donné (vérifié par son relais).
RELAIS_CODE=

# Gemini : gratuit, avec un quota par jour. Crée une clé sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Mistral : payant, quelques centimes par offre.
MISTRAL_API_KEY=
