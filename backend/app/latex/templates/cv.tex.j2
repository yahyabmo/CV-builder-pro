% Titre de rubrique avec son filet. L'espace avant est explicite : dans une
% minipage, \section le perd.
\BLOCK{set titles = s.section_titles}
\newcommand{\rubrique}[2][\VAR{h.glue(sp.section_gap_pt, sp.section_stretch)}]{%
  \par\vspace{#1}%
\BLOCK{if titles.variant == "band"}
  \noindent\begin{tikzpicture}\node[fill=\VAR{h.color(titles.band_color)}, rounded corners=\VAR{pt(titles.band_radius_pt)}pt, inner sep=\VAR{pt(titles.band_padding_pt)}pt, text width={\linewidth-\VAR{pt(2 * titles.band_padding_pt)}pt}, align=left]{\VAR{h.size(b.section_title)}\VAR{h.fmt_in(b.section_title, "#2", titles.band_text_color)}};\end{tikzpicture}\par
  \vspace{\VAR{pt(sp.after_title_pt)}pt}}
\BLOCK{else}
  {\VAR{h.size(b.section_title)}\VAR{h.fmt(b.section_title, "#2")}\par}%
\BLOCK{if titles.variant == "rule" and sp.title_rule_visible}
  \vspace{\VAR{pt(sp.title_rule_gap_pt)}pt}{\color{\VAR{h.color(sp.title_rule_color)}}\hrule height \VAR{pt(sp.title_rule_thickness_pt)}pt}\vspace{\VAR{pt(sp.after_title_pt)}pt}}
\BLOCK{else}
  \vspace{\VAR{pt(sp.after_title_pt)}pt}}
\BLOCK{endif}
\BLOCK{endif}

\setlist[itemize]{label=\VAR{h.bullet()}, leftmargin=\VAR{pt(s.lists.leftmargin_pt)}pt, labelsep=\VAR{pt(s.lists.labelsep_pt)}pt, itemsep=\VAR{h.stretch(s.lists.left.itemsep_pt, s.lists.left.itemsep_stretch_pt)}, parsep=0pt, topsep=\VAR{h.stretch(s.lists.left.topsep_pt, s.lists.left.topsep_stretch_pt)}}
\pagestyle{empty}

% Espace entre deux entrées d'une rubrique, et entre deux blocs de compétences.
\newcommand{\entre}{\par\vspace{\VAR{h.glue(sp.entry_gap_pt, sp.entry_stretch)}}}
\newcommand{\petitentre}{\par\vspace{\VAR{h.glue(sp.skill_gap_pt, sp.skill_stretch)}}}
% Hauteur laissée aux deux colonnes : tout le reste de la page.
\newlength{\hauteurcol}

\BLOCK{macro section(sec, first)}
\VAR{mark("section", sec.id)}
\BLOCK{if first}
\rubrique[0pt]{\VAR{e(sec.title)}}
\BLOCK{else}
\rubrique{\VAR{e(sec.title)}}
\BLOCK{endif}

\BLOCK{if sec.kind == "education"}
\BLOCK{for it in sec.items}
\BLOCK{if not loop.first}
\entre
\BLOCK{endif}
\VAR{mark("item", sec.id, loop.index0)}
\BLOCK{set head = lines(h.fmt(b.entry_title, e(it.title)) if it.title.strip() else "", e(it.place), h.fmt(b.date, e(it.dates)) if it.dates.strip() else "")}
\BLOCK{if head and it.description.strip()}
\VAR{head}\\
\VAR{rich(it.description)}
\BLOCK{elif head}
\VAR{head}
\BLOCK{elif it.description.strip()}
\VAR{rich(it.description)}
\BLOCK{endif}

\BLOCK{endfor}
\BLOCK{elif sec.kind == "skills"}
\BLOCK{for it in sec.items}
\BLOCK{if not loop.first}
\petitentre
\BLOCK{endif}
\VAR{mark("item", sec.id, loop.index0)}
\VAR{h.fmt(b.skill_label, e(it.label))}\\
\VAR{rich(it.text)}

\BLOCK{endfor}
\BLOCK{elif sec.kind == "grid"}
{\renewcommand{\arraystretch}{\VAR{pt(s.grid.arraystretch)}}%
\begin{tabular}{@{}p{\VAR{pt(s.grid.first_col)}\linewidth}@{\hspace{\VAR{pt(s.grid.gap)}\linewidth}}p{\VAR{pt(s.grid.second_col)}\linewidth}@{}}
\BLOCK{set cell = namespace(i=0)}
\BLOCK{for row in grid_rows(sec.items)}
\VAR{mark("item", sec.id, cell.i)}
\BLOCK{if row[0] == "pair"}
\VAR{h.bullet()}\ \VAR{rich(row[1])} & \VAR{h.bullet()}\ \VAR{rich(row[2])} \\
\BLOCK{elif row[0] == "single"}
\VAR{h.bullet()}\ \VAR{rich(row[1])} & \\
\BLOCK{else}
\multicolumn{2}{@{}l@{}}{\VAR{h.bullet()}\ \VAR{rich(row[1])}} \\
\BLOCK{endif}
\BLOCK{set cell.i = cell.i + (2 if row[0] == "pair" else 1)}
\BLOCK{endfor}
\end{tabular}\par}

\BLOCK{elif sec.kind == "languages"}
\BLOCK{for it in sec.items}
\VAR{mark("item", sec.id, loop.index0)}
\VAR{h.fmt(b.language_name, e(it.name) ~ (" :" if it.level.strip() else ""))} \VAR{e(it.level)}\BLOCK{if not loop.last}\\\BLOCK{endif}

\BLOCK{endfor}

\BLOCK{elif sec.kind == "bullets"}
\begin{itemize}[leftmargin=*]
\BLOCK{for it in sec.items}
\VAR{mark("item", sec.id, loop.index0)}
    \item \VAR{rich(it)}
\BLOCK{endfor}
\end{itemize}

\BLOCK{elif sec.kind == "experience"}
\BLOCK{for it in sec.items}
\BLOCK{if not loop.first}
\entre
\BLOCK{endif}
\BLOCK{set n = loop.index0}
\VAR{mark("item", sec.id, n)}
\BLOCK{if sec.layout == "detailed"}
{\VAR{h.size(b.experience_title)}\VAR{h.fmt(b.experience_title, e(it.title))}\enspace{\VAR{h.size(b.experience_tag)}\VAR{h.fmt(b.experience_tag, ("· " ~ e(it.tag)) if it.tag else "")}}\par}
{\VAR{h.size(b.experience_place)}\VAR{h.fmt(b.experience_place, e(it.place))}\hfill{\VAR{h.size(b.date_in_place)}\VAR{h.fmt(b.date_in_place, e(it.dates))}}\par}\vspace{\VAR{pt(sp.place_gap_pt)}pt}
\BLOCK{else}
\VAR{h.fmt(b.entry_title, e(it.title))}\\
\VAR{e(it.place)} \hfill \VAR{h.fmt(b.date, e(it.dates))}\par\vspace{\VAR{pt(sp.place_gap_pt)}pt}
\BLOCK{endif}
\BLOCK{if it.bullets}
\begin{itemize}
\BLOCK{for bullet in it.bullets}
\VAR{mark("bullet", sec.id, n, loop.index0)}
    \item \VAR{rich(bullet)}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endif}

\BLOCK{endfor}
\BLOCK{elif sec.kind == "projects"}
\BLOCK{for it in sec.items}
\BLOCK{set n = loop.index0}
\BLOCK{if not loop.first}
\entre
\BLOCK{endif}
\VAR{mark("item", sec.id, loop.index0)}
\par\VAR{h.fmt(b.project_title, e(it.title))}\BLOCK{if it.tag}\enspace{\VAR{h.size(b.project_tag)}\VAR{h.fmt(b.project_tag, "· " ~ e(it.tag))}}\BLOCK{endif}\hfill\VAR{h.fmt(b.date, e(it.date))}\par
\VAR{rich(it.description)}
\BLOCK{if it.bullets}
\begin{itemize}
\BLOCK{for bullet in it.bullets}
\VAR{mark("bullet", sec.id, n, loop.index0)}
    \item \VAR{rich(bullet)}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endif}
\BLOCK{endfor}

\BLOCK{endif}
\BLOCK{endmacro}

