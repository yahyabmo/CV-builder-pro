# Réglages du serveur. installer.sh copie ce fichier en serveur/.env (lisible par root seul) ;
# remplis chaque valeur en suivant serveur/README.md, puis : docker compose up -d
# Ce fichier .env ne quitte jamais le serveur.

# Ton adresse : elle entre toujours et voit la page Administration.
CVB_ADMIN=

# Cloudflare Access (étape 4 du guide) : le domaine d'équipe et l'« Application Audience (AUD) Tag ».
CF_ACCESS_TEAM=
CF_ACCESS_AUD=

# Le tunnel (étape 5) : le jeton donné par Cloudflare à la création du tunnel.
TUNNEL_TOKEN=

# La liste des invités tenue depuis ta page Administration (étape 6).
CF_ACCOUNT_ID=
CF_ACCESS_GROUP_ID=
CF_API_TOKEN=

# Le code « serveur » du relais Gemini (étape 7) : npm run code -- serveur "En ligne"
RELAIS_CODE=

# Compilations LaTeX en même temps, au plus (3 sur un serveur à 2 processeurs).
CVB_COMPILES=3
